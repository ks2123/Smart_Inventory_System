NODE_ENV=development
PORT=3000

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=asset-images

# Shared secret burned into the ESP32 firmware (min 16 chars). Generate: openssl rand -hex 24
DEVICE_API_KEY=change-me-to-a-long-random-string

# Optional: static key for admin scripts / quick testing (min 16 chars).
# Dashboard users should authenticate with Supabase JWTs instead.
# ADMIN_API_KEY=another-long-random-string

# Comma-separated list of dashboard origins, or * for any
CORS_ORIGINS=*

# Set false to allow registering assets without a photo
REQUIRE_IMAGE=true
